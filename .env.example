APP_NAME="HB Metals India"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5000

# Database Configuration (supports pgsql, sqlite, mysql)
DB_CONNECTION=pgsql
DB_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hbmetals
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=public
DB_CHARSET=utf8

# SQLite Fallback File
DB_FILE=storage/database/hbmetals.sqlite

# Mail Configuration
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=info@hbmetals.co.in
MAIL_FROM_NAME="HB Metals India"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Notification recipient for quote requests and contact enquiries
NOTIFICATION_EMAIL=info@hbmetals.co.in
